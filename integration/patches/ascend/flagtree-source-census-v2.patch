new file mode 100644
index 0000000..fd2a298
--- /dev/null
+++ b/third_party/ascend/backend/compiler_identity.py
@@ -0,0 +1,200 @@
+"""Identity of the actual external Ascend compiler, shared by all launch modes."""
+import atexit
+import ctypes
+import hashlib
+import json
+import os
+import stat
+import struct
+import threading
+
+_CACHE = {}
+_LOCK = threading.Lock()
+
+
+class _Invalidations:
+    """One nonblocking Linux watch FD; consume notifications on the calling thread."""
+    _MASK = 0x00000002 | 0x00000004 | 0x00000008 | 0x00000400 | 0x00000800
+    _OVERFLOW = 0x00004000
+    _GONE = 0x00000400 | 0x00000800 | 0x00008000
+
+    def __init__(self):
+        self.fd = None
+        self.failed = False
+        self.supported = True
+        self.pid = os.getpid()
+        self.paths = {}
+        self.descriptors = {}
+        self.epoch = 0
+        try:
+            self.libc = ctypes.CDLL(None, use_errno=True)
+            self.libc.inotify_init1.argtypes = [ctypes.c_int]
+            self.libc.inotify_init1.restype = ctypes.c_int
+            self.libc.inotify_add_watch.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_uint32]
+            self.libc.inotify_add_watch.restype = ctypes.c_int
+            self.libc.inotify_rm_watch.argtypes = [ctypes.c_int, ctypes.c_int]
+            self.libc.inotify_rm_watch.restype = ctypes.c_int
+        except (AttributeError, OSError):
+            self.supported = False
+            self.failed = True
+
+    def close(self):
+        if self.fd is not None:
+            os.close(self.fd)
+        self.fd = None
+        self.paths.clear()
+        self.descriptors.clear()
+
+    def disable(self):
+        self.close()
+        self.failed = True
+        self.epoch += 1
+        _CACHE.clear()
+
+    def forget(self, path):
+        entry = self.paths.pop(path, None)
+        _CACHE.pop(path, None)
+        if entry is not None:
+            wd = entry[0]
+            self.descriptors.pop(wd, None)
+            self.libc.inotify_rm_watch(self.fd, wd)
+
+    def drain(self):
+        if self.fd is None:
+            return
+        while True:
+            try:
+                data = os.read(self.fd, 65536)
+            except BlockingIOError:
+                return
+            except OSError:
+                self.disable()
+                return
+            if not data:
+                self.disable()
+                return
+            offset = 0
+            while offset < len(data):
+                wd, mask, _, length = struct.unpack_from('iIII', data, offset)
+                offset += 16 + length
+                self.epoch += 1
+                if mask & self._OVERFLOW:
+                    # Events were lost: correctness falls back to fresh hashing.
+                    self.disable()
+                    return
+                path = self.descriptors.get(wd)
+                if path is not None:
+                    _CACHE.pop(path, None)
+                    if mask & self._GONE:
+                        self.forget(path)
+
+    def ensure(self, path, info):
+        if self.pid != os.getpid():
+            self.close()
+            self.pid = os.getpid()
+            self.failed = not self.supported
+            _CACHE.clear()
+        if self.failed:
+            return False
+        if self.fd is None:
+            self.fd = self.libc.inotify_init1(os.O_NONBLOCK | os.O_CLOEXEC)
+            if self.fd < 0:
+                self.fd = None
+                self.disable()
+                return False
+        self.drain()
+        if self.failed:
+            return False
+        entry = self.paths.get(path)
+        inode = (info.st_dev, info.st_ino)
+        if entry is not None and entry[1:] != inode:
+            self.forget(path)
+            entry = None
+        if entry is None:
+            # Bound both watch resources and retained digests in long-lived apps.
+            if len(self.paths) >= 64:
+                self.forget(next(iter(self.paths)))
+            wd = self.libc.inotify_add_watch(self.fd, os.fsencode(path), self._MASK)
+            if wd < 0:
+                self.disable()
+                return False
+            # Hard links can share a watch descriptor. Invalidate the prior name;
+            # a later lookup can establish it again without stale digest reuse.
+            previous = self.descriptors.get(wd)
+            if previous is not None:
+                self.paths.pop(previous, None)
+                _CACHE.pop(previous, None)
+            self.paths[path] = (wd, *inode)
+            self.descriptors[wd] = path
+            _CACHE.pop(path, None)
+        return True
+
+
+_WATCH = _Invalidations()
+atexit.register(_WATCH.close)
+
+
+def _after_fork():
+    global _LOCK
+    _LOCK = threading.Lock()
+    _WATCH.close()
+    _WATCH.pid = os.getpid()
+    _WATCH.failed = not _WATCH.supported
+    _CACHE.clear()
+
+
+if hasattr(os, 'register_at_fork'):
+    os.register_at_fork(after_in_child=_after_fork)
+
+
+def executable_path(path):
+    if not os.path.isabs(path):
+        raise ValueError("TRITON_ASCEND_COMPILER must be an absolute executable path")
+    path = os.path.realpath(path)
+    info = os.stat(path)
+    if not stat.S_ISREG(info.st_mode) or not os.access(path, os.X_OK):
+        raise ValueError("Ascend compiler is not an executable regular file: " + path)
+    return path
+
+
+def _stamp(info):
+    return (info.st_dev, info.st_ino, info.st_size, info.st_ctime_ns, info.st_mtime_ns)
+
+
+def compiler_identity(path):
+    path = executable_path(path)
+    # The stat key detects replacement; notifications also detect same-tick
+    # in-place writes whose size, ctime and restored mtime are all unchanged.
+    with _LOCK:
+        for _ in range(3):
+            before = _stamp(os.stat(path))
+            cacheable = _WATCH.ensure(path, os.stat(path))
+            _WATCH.drain()
+            cacheable = cacheable and not _WATCH.failed
+            epoch = _WATCH.epoch
+            cached = _CACHE.get(path)
+            if cacheable and cached is not None and cached[0] == before:
+                return cached[1]
+            with open(path, "rb") as stream:
+                if _stamp(os.fstat(stream.fileno())) != before:
+                    continue
+                digest = hashlib.sha256()
+                for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+                    digest.update(chunk)
+                after = _stamp(os.fstat(stream.fileno()))
+            _WATCH.drain()
+            if before != after or before != _stamp(os.stat(path)) or epoch != _WATCH.epoch:
+                continue
