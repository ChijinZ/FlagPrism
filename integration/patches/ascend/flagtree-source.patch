 HOST_CAPABILITIES = frozenset({
     "compiler.dialects.v1",
     "compiler.events.v1",
+    "compiler.driver.v1",
     "compiler.options.v1",
     "frontend.statement_events.v1",
     "language.debug_collect.v1",
@@ -309,3 +310,48 @@ def debugger_launch_context(
             kernel_args=kernel_args,
         ),
     )
+
+
+@dataclass
+class CompilerDriverEvent:
+    """A per-compile external-driver handoff; command and environment are private copies."""
+    backend: str
+    command: list[str]
+    environment: dict[str, str]
+    metadata: dict[str, Any]
+
+
+def prepare_compiler_driver(*, backend: str, command: list[str], environment: dict[str, str], metadata: dict[str, Any]) -> CompilerDriverEvent:
+    event = CompilerDriverEvent(str(backend), list(command), dict(environment), metadata)
+    for callback in _registered_callbacks("on_prepare_compiler_driver"):
+        callback(event)
+    return event
+
+
+def finish_compiler_driver(event: CompilerDriverEvent, *, returncode: int) -> None:
+    for callback in _registered_callbacks("on_finish_compiler_driver"):
+        callback(event, returncode=int(returncode))
+
+
+def compiler_driver_cache_key() -> str:
+    """Components identify codegen-affecting driver configuration before caching."""
+    values = []
+    for callback in _registered_callbacks("compiler_driver_cache_key"):
+        values.append(str(callback()))
+    return "|".join(values)
+
+
+def get_cann_launch_receipt_abi() -> str:
+    """Optional authoritative C ABI for generated SDK launch-worker receipts."""
+    values = []
+    for callback in _registered_callbacks("get_cann_launch_receipt_abi"):
+        value = callback()
+        if value:
+            if not isinstance(value, str):
+                raise TypeError("CANN receipt ABI provider must return header text")
+            values.append(value)
+    if not values:
+        return ""
+    if len(set(values)) != 1:
+        raise RuntimeError("multiple incompatible CANN receipt ABI providers")
+    return values[0]
