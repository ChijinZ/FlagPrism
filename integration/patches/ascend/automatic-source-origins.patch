+def _flagprism_automatic_source_info(opt):
+    # The public automatic request is frozen in instrumentation_mode and its
+    # normal NPUOptions hash. Preserve source locations only for that compile;
+    # do not change process-global debug settings or device completion semantics.
+    mode = getattr(opt, "instrumentation_mode", "")
+    if "|config=" not in mode:
+        return False
+    config = json.loads(mode.split("|config=", 1)[1])
+    request = config.get("debug_observation_request")
+    return isinstance(request, dict) and request.get("automatic") is True
