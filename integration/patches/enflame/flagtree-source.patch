diff --git a/third_party/enflame/backend/compiler.py b/third_party/enflame/backend/compiler.py
index db4c5ff..dfed6b6 100644
--- a/third_party/enflame/backend/compiler.py
+++ b/third_party/enflame/backend/compiler.py
@@ -203,6 +203,39 @@ def make_ttgir(mod, metadata, options):
 # FlagPrism: local collect regions can request L2 under a global L1 default.
 # The payload plan after TTIR instrumentation determines the SDK's i64 requirement.
 def _debug_codegen_options(options, metadata):
+    if metadata.get("debug_clock_domain") == "enflame.sdk.global_timer":
+        if options.arch != "gcu300":
+            raise RuntimeError("FlagPrism SDK global timer currently supports GCU300 only")
+        # GCU300 compilation uses the LLVM11 SDK toolchain. Link its installed
+        # read-only helper, not the LLVM18 library at the top-level SDK path.
+        library = os.path.join(toolkit.get_tops_home(), "llvm11", "lib", "krt",
+                               "gcu300_api_profile.bc")
+        if not os.path.isfile(library):
+            raise RuntimeError("GCU300 read-only SDK timer library is unavailable: " + library)
+        libraries = tuple(options.extern_libs or ())
+        if not any(path == library for _, path in libraries):
+            libraries += (("flagprism_sdk_global_timer", library),)
+        if metadata.get("debug_clock_identity_version") == 1:
+            from flagtree.debugger.gcu_clock import identity_library
+            identity = identity_library(tops_home=toolkit.get_tops_home())
+            metadata["debug_clock_identity_library_sha256"] = identity["sha256"]
+            metadata["debug_clock_identity_tool_sha256"] = identity["inputs"]["tool_sha256"]
+            if not any(path == identity["file"] for _, path in libraries):
+                libraries += (("flagprism_clock_identity", identity["file"]),)
+        # Dynamic counters and pointers use validated i32. The SDK clock
+        # alone stays LLVM i64 and is split immediately into two i32 words.
+        dynamic_words = metadata.get("debug_clock_carrier") == "llvm_i64_words"
+        selected_i64 = options.enable_i64 if dynamic_words else True
+        metadata["enable_i64"] = selected_i64
+        metadata["debug_clock_library"] = library
+        with open(library, "rb") as stream:
+            metadata["debug_clock_library_sha256"] = hashlib.sha256(stream.read()).hexdigest()
+        metadata["debug_clock_primitive"] = "_ZN4tops12global_timerEv"
+        metadata["debug_clock_frequency_verified"] = False
+        metadata["debug_clock_bits"] = 46
+        metadata["debug_clock_unit"] = "tick"
+        # No SDK frequency/calibration relationship is assumed.
+        return replace(options, enable_i64=selected_i64, extern_libs=libraries)
     if (options.instrumentation_mode.startswith("debugger")
             and metadata.get("debug_full_dump_payload_bytes_per_instance", 0) > 0 and not options.enable_i64):
         metadata["enable_i64"] = True
@@ -302,6 +335,14 @@ def make_gcuir(mod, metadata, options):
             if metadata['tle_raw_deferred']:
                 gcu_passes.gcu400.add_tle_dslregion_inline(pm)
     gcu_passes.mlir.add_print_op_generic(pm)
+    # Preserve actual lowering locations for origin candidates. This changes
+    # serialization, not the pass pipeline or source mathematical operations.
+    pm.add_pass("mlir-print-debuginfo")
+    metadata["gcu_source_location_provenance"] = "compiler_location_chain"
 
-    return pm.run(patched_mod)
+    lowered = pm.run(patched_mod)
+    if metadata.get("debug_execution_version") == 1:
+        from flagtree.debugger.gcu_timeline import rewrite_execution_ir
+        lowered = rewrite_execution_ir(lowered, metadata)
+    return lowered
 
@@ -313,7 +354,8 @@
     passes = []
     if toolkit.get_bool_env("MLIR_ENABLE_DUMP"):
         passes.append('-mlir-print-ir-after-all')
-    if not toolkit.get_bool_env("TRITON_DISABLE_LINE_INFO", True):
+    timeline = metadata.get("debug_execution_version") == 1
+    if not timeline and not toolkit.get_bool_env("TRITON_DISABLE_LINE_INFO", True):
         passes.append('--ensure-debug-info-scope-on-llvm-func')
     if toolkit.get_bool_env("MLIR_ENABLE_TIMING"):
         passes.append('--mlir-timing')
@@ -343,7 +385,19 @@
     #    paths = [path for (name, path) in options.extern_libs]
     #    llvm.link_extern_libs(llvm_mod, paths)
 
-    return toolkit.gcu_compiler_opt(mod, *passes)
+    if timeline:
+        passes.append('--mlir-print-debuginfo')
+    lowered = toolkit.gcu_compiler_opt(mod, *passes)
+    if timeline:
+        from flagtree.debugger.gcu_timeline import preserve_native_locations
+        scoped = preserve_native_locations(lowered, metadata)
+        # The public DI bridge keeps vendor properties opaque. Only the real
+        # SDK can validate them; do not use its output without this verifier.
+        lowered = toolkit.gcu_compiler_opt(scoped, '--mlir-print-debuginfo')
+        metadata['debug_execution_native_ir_sha256'] = hashlib.sha256(lowered.encode()).hexdigest()
+        from flagtree.debugger.gcu_timeline import bind_execution_structure
+        bind_execution_structure(lowered, metadata)
+    return lowered
 
 
 # FlagPrism: the GCU300 SDK may optimize scalar L2 summary sqrt(x*x)
@@ -432,6 +486,10 @@
                 _compile_with_debugger_fabs(mod, options, tmpdir, compile_args)
                 metadata['debug_math_compat'] = 'scalar_fabs'
             with open(bin, "rb") as f:
-                return f.read()
+                binary = f.read()
+            if metadata.get("debug_execution_version") == 1:
+                from flagtree.debugger.gcu_timeline import bind_native_clock_locations
+                bind_native_clock_locations(binary, metadata)
+            return binary
 
 
diff --git a/third_party/enflame/triton_gcu/triton_gcu300/lib/triton_gcu300_core.cpp b/third_party/enflame/triton_gcu/triton_gcu300/lib/triton_gcu300_core.cpp
