   bool printModuleScope = false;
@@ -107,6 +108,10 @@ void gcu300_pipeline_add_pass(Gcu300Pipeline p, const char *pass_name,
 
   llvm::StringRef name(pass_name);
 
+  if (name == "mlir-print-debuginfo") {
+    p->printDebugInfo = true;
+    return;
+  }
   if (name == "mlir-print-op-generic") {
     p->printGeneric = true;
     return;
@@ -205,6 +210,8 @@ Gcu300String gcu300_pipeline_run(Gcu300Pipeline p, const char *input,
